# Gemini API anahtarı (Katman C — birincil LLM)
# https://aistudio.google.com/app/apikey adresinden ücretsiz alınabilir
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API anahtarı (Katman C — karşılaştırma, opsiyonel)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hangi LLM sağlayıcısı kullanılsın (gemini | claude)
LAYER_C_PROVIDER=gemini

# Frontend'in backend'e erişeceği URL (tarayıcı tarafından kullanılır)
# Yerel Docker: http://localhost:8000
# Prodüksiyon VPS: http://SUNUCU_IP:8000 veya https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend CORS izin listesi (virgülle ayır)
# Yerel geliştirme: boş bırakın (localhost otomatik izinli)
# Prodüksiyon VPS: frontend'in dış adresi
# Örn: CORS_ORIGINS=http://192.168.1.100:3000
CORS_ORIGINS=
