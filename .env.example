# ════════════════════════════════════════════════════════════════════════════
#  Ortam Değişkenleri — örnek şablon
#  Yerel Docker:  `cp .env.example .env` ve değerleri doldur, `docker compose up`
#  Deploy:        BACKEND değişkenleri → Render · FRONTEND değişkeni → Vercel
# ════════════════════════════════════════════════════════════════════════════

# ─── BACKEND (Render Web Service / yerel backend) ──────────────────────────

# Gemini API anahtarı (Katman C — birincil LLM). Boşsa Katman C sessizce devre dışı.
# Ücretsiz: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API anahtarı (Katman C — yedek sağlayıcı, Llama 3.3 70B). Opsiyonel.
# Ücretsiz: https://console.groq.com/keys
GROQ_API_KEY=

# Hangi LLM sağlayıcısı kullanılsın: gemini | groq
LAYER_C_PROVIDER=gemini

# Model ID. gemini → gemini-2.5-flash · groq → llama-3.3-70b-versatile
LAYER_C_MODEL=gemini-2.5-flash

# Backend CORS izin listesi (tarayıcıdan gelen frontend origin'i):
#   · Virgülle ayrılmış:  CORS_ORIGINS=https://my-app.vercel.app
#   · Demo için tümü:     CORS_ORIGINS=*
# Yerel geliştirmede boş bırakılabilir (localhost origin'leri otomatik izinli).
CORS_ORIGINS=

# Backend portu. Yerelde 8000; Render bu değişkeni OTOMATİK enjekte eder (elle ayarlama).
PORT=8000

# Katman B anlamsal embedding modeli (RAG). Varsayılan: intfloat/multilingual-e5-small.
# Alternatif: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# DİKKAT: model + torch ~400 MB RAM ister. 512 MB Free planlarda OOM riski vardır;
# model yüklenemezse otomatik hash fallback devreye girer (retrieval kalitesi düşer).
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ─── FRONTEND (Vercel / yerel frontend) ────────────────────────────────────

# Frontend'in backend'e eriştiği URL (tarayıcıda kullanılır, build-time'da inline edilir).
#   · Yerel Docker:  http://localhost:8000
#   · Vercel:        https://<render-backend>.onrender.com   (sondaki "/" olmadan)
NEXT_PUBLIC_API_URL=http://localhost:8000
