# ════════════════════════════════════════════════════════════════════════════
#  DigitalOcean Droplet — ortam değişkenleri örneği
#  Sunucuda:  cp .env.digitalocean.example .env   ve değerleri doldur
#  Ardından:  ./scripts/deploy-digitalocean.sh
#             (veya docker compose -f docker-compose.prod.yml up --build -d)
#
#  NOT: Bu uygulama Katman C'de Gemini (birincil) ve Groq (yedek) sağlayıcılarını
#       destekler. Anthropic/Claude kullanılmaz.
# ════════════════════════════════════════════════════════════════════════════

# ─── Katman C (LLM) ─────────────────────────────────────────────────────────
# Gemini — birincil sağlayıcı (ücretsiz: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Groq — yedek sağlayıcı, opsiyonel (ücretsiz: https://console.groq.com/keys)
GROQ_API_KEY=

# Hangi sağlayıcı kullanılsın: gemini | groq
LAYER_C_PROVIDER=gemini

# Model ID. gemini → gemini-2.5-flash · groq → llama-3.3-70b-versatile
LAYER_C_MODEL=gemini-2.5-flash

# ─── IP ile test (domain yokken) ────────────────────────────────────────────
# SERVER_IP yerine Droplet'in genel IP adresini yazın (ör. 167.99.10.20).
# Nginx /api ön ekini backend'e proxy'ler (bkz. docs/nginx-ip.conf).
NEXT_PUBLIC_API_URL=http://SERVER_IP/api
CORS_ORIGINS=http://SERVER_IP

# ─── Domain ile production (yukarıdaki iki satırı silip bunları açın) ────────
# NEXT_PUBLIC_API_URL=https://api.domain.com
# CORS_ORIGINS=https://domain.com,https://www.domain.com
